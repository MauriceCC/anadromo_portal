* text=auto
*.md text eol=lf
*.css text eol=lf
*.json text eol=lf
*.svg text eol=lf
*.vtt text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.webm binary
*.pdf binary

# Copias optimizadas para Pages: se versionan sin Git LFS.
public/media/optimized/*.mp4 -filter -diff -merge -text
